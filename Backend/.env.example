# Copy to Backend/.env on the server and fill in real values.
DATABASE_URL="postgresql://emlr:CHANGE_ME@localhost:5432/emlr?schema=public"
PORT=5050
NODE_ENV=production

# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="7d"

# The public website address(es), comma-separated.
CORS_ORIGINS="https://emlrkicukiro.rw,https://www.emlrkicukiro.rw"

# Chat assistant (Google AI Studio key) and YouTube Data API key (restrict it to the server IP).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
YOUTUBE_API_KEY=""

# First admin account, created only when the database is empty. Use a strong password,
# then change it from Dashboard → Account & users after first login.
SEED_ADMIN_EMAIL="admin@emlrkicukiro.rw"
SEED_ADMIN_PASSWORD="CHANGE_ME"
