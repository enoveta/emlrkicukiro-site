generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CONTENT_MANAGER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum PersonTeam {
  NATIONAL
  PARISH
  OTHER
}

enum SubmissionStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventsCreated        Event[]        @relation("EventCreatedBy")
  announcementsCreated Announcement[] @relation("AnnouncementCreatedBy")
  servicesCreated      Service[]      @relation("ServiceCreatedBy")
  projectsCreated      Project[]      @relation("ProjectCreatedBy")
  bannersCreated       Banner[]       @relation("BannerCreatedBy")
  ministriesCreated    Ministry[]     @relation("MinistryCreatedBy")
  peopleCreated        Person[]       @relation("PersonCreatedBy")
  galleryCreated       GalleryItem[]  @relation("GalleryCreatedBy")
  testimonialsCreated  Testimonial[]  @relation("TestimonialCreatedBy")
  statsCreated         Stat[]         @relation("StatCreatedBy")
  givingCreated        GivingAccount[] @relation("GivingCreatedBy")
}

model Event {
  id          String  @id @default(uuid())
  title       String
  description String
  titleRw       String?
  descriptionRw String?
  date        DateTime
  time        String
  timeRw      String?
  location    String?
  locationRw  String?
  imageUrl    String?

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("EventCreatedBy", fields: [createdById], references: [id])
}

model Announcement {
  id       String  @id @default(uuid())
  title    String
  content  String
  titleRw   String?
  contentRw String?
  date     DateTime
  imageUrl String?

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
}

model Service {
  id           String  @id @default(uuid())
  serviceTitle String
  topic        String
  preacherName String
  verse        String
  date         DateTime
  imageUrl     String?

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("ServiceCreatedBy", fields: [createdById], references: [id])
}

model Banner {
  id String @id @default(uuid())

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User          @relation("BannerCreatedBy", fields: [createdById], references: [id])
  slides    BannerSlide[]
}

model BannerSlide {
  id        String  @id @default(uuid())
  bannerId  String
  imageUrl  String
  mediaType String  @default("image")
  text      String?
  title     String?
  highlight String?
  subtitle  String?
  titleRw     String?
  highlightRw String?
  subtitleRw  String?
  cta1      String?
  cta1Rw    String?
  cta1Link  String?
  cta2      String?
  cta2Rw    String?
  cta2Link  String?
  duration  Int     @default(8000)
  hasBlur   Boolean @default(true)
  order     Int

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, order])
}

model Project {
  id            String  @id @default(uuid())
  title         String
  description   String
  goalAmount    Decimal @db.Decimal(12, 2)
  amountReached Decimal @db.Decimal(12, 2) @default(0)
  startDate     DateTime
  endDate       DateTime
  imageUrl      String?

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("ProjectCreatedBy", fields: [createdById], references: [id])
}

model Ministry {
  id               String  @id @default(uuid())
  slug             String  @unique
  name             String
  nameRw           String?
  category         String  @default("general")
  shortDescription String
  shortDescriptionRw String?
  body             String
  bodyRw           String?
  heroImageUrl     String?
  aboutImageUrl    String?
  scheduleLabel    String?
  scheduleLabelRw  String?
  youtubeUrl       String?
  featuredOnHome   Boolean @default(false)
  homeOrder        Int     @default(0)
  sortOrder        Int     @default(0)

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("MinistryCreatedBy", fields: [createdById], references: [id])
}

model Person {
  id        String     @id @default(uuid())
  name      String
  position  String     @default("")
  positionRw String?
  imageUrl  String?
  team      PersonTeam @default(PARISH)
  bio       String?
  phone     String?
  email     String?
  sortOrder Int        @default(0)

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("PersonCreatedBy", fields: [createdById], references: [id])
}

model GalleryItem {
  id        String  @id @default(uuid())
  imageUrl  String
  alt       String  @default("")
  altRw     String?
  caption   String  @default("")
  captionRw String?
  sortOrder Int     @default(0)

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("GalleryCreatedBy", fields: [createdById], references: [id])
}

model Testimonial {
  id        String  @id @default(uuid())
  text      String
  textRw    String?
  author    String
  role      String  @default("")
  roleRw    String?
  imageUrl  String?
  sortOrder Int     @default(0)

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("TestimonialCreatedBy", fields: [createdById], references: [id])
}

model Stat {
  id        String @id @default(uuid())
  number    String
  label     String
  labelRw   String?
  sortOrder Int    @default(0)

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("StatCreatedBy", fields: [createdById], references: [id])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model GivingAccount {
  id            String @id @default(uuid())
  purposeKey    String @unique
  purposeName   String
  purposeNameRw String?
  mtnNumber     String?
  airtelNumber  String?
  mobileName    String?
  bankName      String?
  accountName   String?
  accountNumber String?
  swift         String?
  sortOrder     Int    @default(0)

  status        ContentStatus @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("GivingCreatedBy", fields: [createdById], references: [id])
}

model PrayerRequest {
  id        String           @id @default(uuid())
  name      String
  email     String
  request   String
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model VolunteerApplication {
  id             String           @id @default(uuid())
  name           String
  email          String
  phone          String
  areaOfInterest String
  message        String?
  status         SubmissionStatus @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}
