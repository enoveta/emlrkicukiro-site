#!/usr/bin/env bash
# /usr/local/sbin/emlr-site-ctl  (root-owned, mode 755; the deploy user may run ONLY this via sudo)
# Narrow operations for site.emlrkicukiroparish.org. Touches nothing else on the server.
#
# Security: root never sources .env or executes anything from a release directory (those are
# writable by the deploy user). App commands run as the unprivileged 'emlrsite' user, which
# loads the environment itself.
set -euo pipefail
APP=/var/www/site.emlrkicukiroparish.org
ENV_FILE=$APP/shared/.env
APP_HOME=$APP/releases/.home     # writable scratch HOME for npm/prisma caches
SERVICE=emlr-site-api

as_app() { # as_app <command...>  -> runs in $APP/current/Backend as emlrsite with the app env
  runuser -u emlrsite -- env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$APP_HOME" CHECKPOINT_DISABLE=1 \
    bash -c 'set -a; . "$0"; set +a; cd "$1" && shift 2 && exec "$@"' "$ENV_FILE" "$APP/current/Backend" -- "$@"
}

remove_seed_password() { # keep owner root:emlrsite and mode 640
  local tmp
  tmp=$(mktemp)
  grep -v '^SEED_ADMIN_PASSWORD=' "$ENV_FILE" > "$tmp" || true
  install -o root -g emlrsite -m 640 "$tmp" "$ENV_FILE"
  rm -f "$tmp"
  echo "SEED_ADMIN_PASSWORD removed from $ENV_FILE"
}

case "${1:-}" in
  migrate-status) as_app npx --no-install prisma migrate status ;;
  migrate)        as_app npx --no-install prisma migrate deploy ;;
  seed)           as_app npx --no-install prisma db seed && remove_seed_password ;;
  restart)        systemctl restart "$SERVICE"; sleep 2; systemctl --no-pager --lines=0 status "$SERVICE" | head -3 ;;
  status)         systemctl --no-pager --lines=20 status "$SERVICE" ;;
  logs)
    n="${2:-100}"; [[ "$n" =~ ^[0-9]{1,5}$ ]] || { echo "lines must be a number"; exit 1; }
    runuser -u emlrsite -- tail -n "$n" /var/log/emlr-site/api.log /var/log/emlr-site/api.error.log ;;
  nginx-reload)   nginx -t && systemctl reload nginx ;;
  backup)         runuser -u emlrsite -- /usr/local/sbin/emlr-site-backup ;;
  *) echo "usage: emlr-site-ctl {migrate-status|migrate|seed|restart|status|logs [n]|nginx-reload|backup}"; exit 1 ;;
esac
