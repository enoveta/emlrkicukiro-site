[Unit]
Description=EMLR Kicukiro site API (site.emlrkicukiroparish.org)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=emlrsite
Group=emlrsite
WorkingDirectory=/var/www/site.emlrkicukiroparish.org/current/Backend
EnvironmentFile=/var/www/site.emlrkicukiroparish.org/shared/.env
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/emlr-site/api.log
StandardError=append:/var/log/emlr-site/api.error.log
# Hardening: read-only system, write only to uploads and logs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/site.emlrkicukiroparish.org/shared/media /var/log/emlr-site
MemoryMax=400M

[Install]
WantedBy=multi-user.target
